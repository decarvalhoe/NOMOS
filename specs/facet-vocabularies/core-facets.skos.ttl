@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix nomosfacet: <https://nomos.dev/facets/core/> .

nomosfacet:scheme a skos:ConceptScheme ;
  skos:prefLabel "Nomos core CKM facet vocabulary"@en .

nomosfacet:trust-tier a skos:Collection ;
  skos:prefLabel "Trust tier"@en ;
  skos:member nomosfacet:certified, nomosfacet:indicative, nomosfacet:unverified .

nomosfacet:certified a skos:Concept ;
  skos:inScheme nomosfacet:scheme ;
  skos:prefLabel "certified"@en ;
  skos:definition "Evidence satisfies the configured deterministic gate for the declared scope."@en .

nomosfacet:indicative a skos:Concept ;
  skos:inScheme nomosfacet:scheme ;
  skos:prefLabel "indicative"@en ;
  skos:definition "Evidence is usable for orientation but insufficient for a certified claim."@en .

nomosfacet:unverified a skos:Concept ;
  skos:inScheme nomosfacet:scheme ;
  skos:prefLabel "unverified"@en ;
  skos:definition "Evidence is absent, incomplete, or blocked by a finding."@en .
